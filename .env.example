DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/vigen"
AUTH_SECRET=""

# URL pública (links nos e-mails)
APP_URL="http://localhost:3000"

# E-mail: arquivo (padrão dev, grava .eml em ./storage/emails) | console (padrão prod) | smtp | resend
# ATENÇÃO: em produção o padrão é "console" — os e-mails NÃO são enviados, apenas registrados no log
# (destinatário + assunto). Para enviar de fato, defina EMAIL_DRIVER=smtp (SMTP_*) ou resend (RESEND_API_KEY).
EMAIL_DRIVER=""
EMAIL_REMETENTE="Vigen <nao-responda@exemplo.com.br>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
RESEND_API_KEY=""

# Crons (/api/cron/diario e /api/cron/semanal): header Authorization: Bearer <CRON_SECRET>
# OBRIGATÓRIO: sem ele os crons respondem 401/500. Gere um valor aleatório, ex.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""
