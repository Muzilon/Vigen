  @@unique([empresaId, id])
  @@unique([empresaId, numero])
  @@unique([empresaId, planoAcaoId])
  @@index([empresaId, processoId])
  @@index([empresaId, faixa])
  @@index([empresaId, proximaReavaliacaoEm])
  @@map("risco_oportunidade")
}

/// Histórico de cada avaliação/reavaliação/alteração do risco. Append-only (trigger).
