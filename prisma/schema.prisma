generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Plano {
  BASICO
  PROFISSIONAL
  ENTERPRISE
}

/// Módulos contratáveis por empresa (Empresa.modulosAtivos). Somente RNC e PLANO_ACAO têm
/// funcionalidade implementada hoje; os demais existem para o gating (menu/rotas) já
/// funcionar conforme cada pacote (docs/06-desenho-modulos.md) é entregue.
/// Decisão: INSPECAO/AUDITORIA foram renomeados para INSPECOES/AUDITORIAS (plural, consistente
/// com os demais módulos novos) — nenhum modelo usava esses valores ainda.
enum Modulo {
  RNC
  PLANO_ACAO
  MAPA_PROCESSOS
  RISCOS_OPORTUNIDADES
  SWOT
  HIRA
  LAIA
  INSPECOES
  AUDITORIAS
  DOCUMENTOS
  REQUISITOS_LEGAIS
  INCIDENTES
  INDICADORES
  TREINAMENTOS
}

/// Tipo de matriz/escala configurável (ConfiguracaoEscala). Reaproveitada por Riscos e
/// Oportunidades, HIRA e LAIA (aspecto/impacto ambiental).
enum TipoEscala {
  RISCO_OPORTUNIDADE
  HIRA
  ASPECTO_IMPACTO
}

enum PapelUsuario {
  ADMIN
  GESTOR_SGI
  INSPETOR
  COLABORADOR
}

enum Permissao {
  RNC_ABRIR
  RNC_TRATAR
  RNC_VERIFICAR_EFICACIA
  RNC_SOLICITAR_CANCELAMENTO
  RNC_APROVAR_CANCELAMENTO
  RNC_VER_RESTRITAS
  PLANO_GERENCIAR
  PROCESSO_GERENCIAR
  ADMIN_CONFIG
  VER_TODAS_OBRAS
  RISCO_GERENCIAR
  RISCO_TRATAR
  SWOT_GERENCIAR
  HIRA_GERENCIAR
  LAIA_GERENCIAR
  DOCUMENTO_ELABORAR
  DOCUMENTO_GERENCIAR
  INSPECAO_GERENCIAR
  INSPECAO_REALIZAR
  AUDITORIA_GERENCIAR
  AUDITORIA_REALIZAR
  REQUISITO_LEGAL_GERENCIAR
  INCIDENTE_GERENCIAR
  INCIDENTE_VER_RESTRITOS
  INDICADOR_GERENCIAR
  TREINAMENTO_GERENCIAR
}

enum EscopoObras {
  TODAS
  SELECIONADAS
}

enum TipoRnc {
  QUALIDADE
  MEIO_AMBIENTE
  SSO
}

enum OrigemRnc {
  AUDITORIA_INTERNA
  INSPECAO
  RECLAMACAO_CLIENTE
  AUTO_IDENTIFICADA
  AUDITORIA_EXTERNA
}

enum Gravidade {
  BAIXA
  MEDIA
  ALTA
  CRITICA
}

enum MetodoCausaRaiz {
  CINCO_PORQUES
  ISHIKAWA
  OUTRO
}

enum StatusRnc {
  ABERTO
  EM_ANALISE
  PLANO_EM_EXECUCAO
  EM_VERIFICACAO
  ENCERRADO
  REABERTO
  CANCELADO
}

enum ResultadoVerificacao {
  EFICAZ
  INEFICAZ
}

enum StatusSolicitacaoCancelamento {
  PENDENTE
  APROVADA
  REJEITADA
}

enum OrigemPlanoAcao {
  RNC
  INSPECAO
  AUDITORIA
  MANUAL
  RISCO_OPORTUNIDADE
  HIRA
  LAIA
  REQUISITO_LEGAL
  INCIDENTE
}

enum StatusItemAcao {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDO
  CANCELADO
}

enum TipoEntidadeAnexo {
  RNC
  RNC_DADOS_SENSIVEIS
  VERIFICACAO_EFICACIA
  PLANO_ACAO
  ITEM_ACAO
  PROCESSO
  RISCO_OPORTUNIDADE
  HIRA
  LAIA
  DOCUMENTO_VERSAO
  RESPOSTA_INSPECAO
  CONSTATACAO_AUDITORIA
  REQUISITO_LEGAL
  INCIDENTE
  INCIDENTE_DADOS_SENSIVEIS
  CERTIFICADO_TREINAMENTO
}

enum TipoEntidadeInteracao {
  RNC
  ITEM_ACAO
  PROCESSO
  RISCO_OPORTUNIDADE
  HIRA
  LAIA
  DOCUMENTO
  INSPECAO
  AUDITORIA
  REQUISITO_LEGAL
  INCIDENTE
  INDICADOR
  TREINAMENTO
}

enum TipoNotificacao {
  RNC_ATRIBUIDA
  ITEM_ATRIBUIDO
  INTERACAO_NOVA
  CANCELAMENTO_SOLICITADO
  CANCELAMENTO_DECIDIDO
  RNC_EM_VERIFICACAO
  ITEM_PRAZO_PROXIMO
  ITEM_ATRASADO
  RESUMO_SEMANAL
  APROVACAO_PENDENTE
  APROVACAO_DECIDIDA
  REAVALIACAO_PROXIMA
  DOCUMENTO_PUBLICADO
  CIENCIA_PENDENTE
  REVISAO_DOCUMENTO_PROXIMA
  AUDITORIA_ATRIBUIDA
  INCIDENTE_REGISTRADO
  INCIDENTE_ATRIBUIDO
  INDICADOR_SEM_LANCAMENTO
  TREINAMENTO_VENCENDO
  ITEM_CONCLUIDO_SEM_EVIDENCIA
}

enum TipoEntidadeNotificacao {
  RNC
  ITEM_ACAO
  FLUXO_APROVACAO
  PROCESSO
  RISCO_OPORTUNIDADE
  HIRA
  LAIA
  DOCUMENTO
  INSPECAO
  AUDITORIA
  REQUISITO_LEGAL
  INCIDENTE
  INDICADOR
  TREINAMENTO
}

enum StatusEmailNotificacao {
  PENDENTE
  ENVIADO
  IGNORADO
  FALHOU
}

/// Entidade alvo de um fluxo de aprovação (motor multi-assinante, src/lib/aprovacao).
/// TESTE: usado só pelos scripts de teste (handler registrado no próprio script).
enum TipoEntidadeAprovacao {
  PROCESSO
  HIRA
  LAIA
  DOCUMENTO
  RISCO_OPORTUNIDADE
  TESTE
}

enum TipoAlteracaoAprovacao {
  INCLUSAO
  ALTERACAO
  EXCLUSAO
  PUBLICACAO
}

enum ModoAprovacao {
  SEQUENCIAL
  PARALELO
}

enum StatusFluxoAprovacao {
  PENDENTE
  APROVADO
  REJEITADO
  CANCELADO
}

/// AGUARDANDO: ainda não é a vez (sequencial). IGNORADA: fluxo encerrado antes da decisão.
enum StatusEtapaAprovacao {
  AGUARDANDO
  PENDENTE
  APROVADA
  REJEITADA
  IGNORADA
}

enum AcaoHistoricoAprovacao {
  SOLICITADO
  APROVADO
  REJEITADO
  CANCELADO
  CONCLUIDO
}

/// Tipo do processo no mapa (raias do diagrama: Gestão topo, Finalísticos meio, Apoio embaixo).
enum TipoProcesso {
  GESTAO
  FINALISTICO
  APOIO
}

enum TipoRiscoOportunidade {
  RISCO
  OPORTUNIDADE
}

enum TratamentoRisco {
  ACEITAR
  MITIGAR
  TRANSFERIR
  EVITAR
  EXPLORAR
}

enum StatusRiscoOportunidade {
  IDENTIFICADO
  EM_TRATAMENTO
  MONITORADO
  ENCERRADO
}

/// Faixa do nível calculado (ConfiguracaoEscala.faixas[].nivel).
enum FaixaNivel {
  BAIXO
  MEDIO
  ALTO
  CRITICO
}

/// ITEM: cada registro tem sua data; GERAL: revisão geral (todos do processo/empresa de uma vez).
enum ModoReavaliacao {
  ITEM
  GERAL
}

enum AcaoHistoricoRisco {
  CRIACAO
  ALTERACAO
  TRATAMENTO
  REAVALIACAO
  REVISAO_GERAL
  STATUS
  EXCLUSAO
}

/// Condição/situação operacional (HIRA e LAIA).
enum CondicaoOperacional {
  NORMAL
  ANORMAL
  EMERGENCIA
}

/// Hierarquia de controle (ISO 45001 8.1.2).
enum HierarquiaControle {
  ELIMINACAO
  SUBSTITUICAO
  ENGENHARIA
  ADMINISTRATIVO
  EPI
}

/// Situação de uma linha de planilha com fluxo de aprovação (HIRA/LAIA).
/// Temporalidade do aspecto ambiental (LAIA).
enum Temporalidade {
  PASSADA
  ATUAL
  FUTURA
}

/// Incidência do aspecto (controle direto da organização ou influência indireta).
enum Incidencia {
  DIRETA
  INDIRETA
}

enum StatusLinhaSgi {
  PENDENTE_APROVACAO
  VIGENTE
  REJEITADA
  INATIVA
}

enum AcaoHistoricoSgi {
  INCLUSAO
  ALTERACAO
  EXCLUSAO
  REAVALIACAO
  REVISAO_GERAL
  PLANO
  APROVACAO
  REJEICAO
}

enum QuadranteSwot {
  FORCA
  FRAQUEZA
  OPORTUNIDADE
  AMEACA
}

enum TipoSequencia {
  RNC
  DOCUMENTO
  INSPECAO
  AUDITORIA
  REQUISITO_LEGAL
  INCIDENTE
}

model Empresa {
  id              String   @id @default(uuid()) @db.Uuid
  nome            String
  cnpj            String?  @unique
  segmento        String?
  plano           Plano    @default(BASICO)
  modulosAtivos   Modulo[] @default([RNC, PLANO_ACAO]) @map("modulos_ativos")
  diasAlertaPrazo Int      @default(3) @map("dias_alerta_prazo")
  fusoHorario     String   @default("America/Sao_Paulo") @map("fuso_horario")
  config          Json     @default("{}")
  ativo           Boolean  @default(true)
  criadoEm        DateTime @default(now()) @map("criado_em")
  atualizadoEm    DateTime @updatedAt @map("atualizado_em")

  obras                    ObraUnidade[]
  setores                  Setor[]
  perfis                   Perfil[]
  usuarios                 Usuario[]
  acessosObra              UsuarioAcessoObra[]
  contadores               ContadorSequencial[]
  rncs                     Rnc[]
  rncDadosSensiveis        RncDadosSensiveis[]
  verificacoes             VerificacaoEficacia[]
  historicosStatus         HistoricoStatusRnc[]
  solicitacoesCancelamento SolicitacaoCancelamento[]
  planosAcao               PlanoAcao[]
  itensAcao                ItemAcao[]
  anexos                   Anexo[]
  interacoes               Interacao[]
  leiturasInteracao        LeituraInteracao[]
  notificacoes             Notificacao[]
  configuracoesEscala      ConfiguracaoEscala[]
  fluxosAprovacao          FluxoAprovacao[]
  etapasAprovacao          EtapaAprovacao[]
  historicosAprovacao      HistoricoAprovacao[]
  processos                Processo[]
  indicadoresProcesso      IndicadorProcesso[]
  interacoesProcesso       InteracaoProcesso[]
  versoesProcesso          VersaoProcesso[]
  riscosOportunidades      RiscoOportunidade[]
  historicosRisco          HistoricoRiscoOportunidade[]
  ciclosSwot               CicloSwot[]
  itensSwot                ItemSwot[]
  partesInteressadas       ParteInteressada[]
  linhasHira               LinhaHira[]
  linhasLaia               LinhaLaia[]
  historicosLaia           HistoricoLinhaLaia[]
  historicosHira           HistoricoLinhaHira[]
  tiposDocumento           TipoDocumentoEmpresa[]
  documentos               Documento[]
  versoesDocumento         VersaoDocumento[]
  publicacoesDocumento     PublicacaoDocumento[]
  cienciasDocumento        CienciaDocumento[]
  historicosDocumento      HistoricoDocumento[]
  modelosChecklist         ModeloChecklist[]
  itensModeloChecklist     ItemModeloChecklist[]
  inspecoes                Inspecao[]
  respostasInspecao        RespostaInspecao[]
  programasAuditoria       ProgramaAuditoria[]
  auditorias               Auditoria[]
  itensAuditoria           ItemAuditoria[]
  constatacoes             Constatacao[]
  incidentes               Incidente[]
  incidentesDadosSensiveis IncidenteDadosSensiveis[]
  historicosIncidente      HistoricoIncidente[]
  indicadores              Indicador[]
  resultadosIndicador      ResultadoIndicador[]
  treinamentos             Treinamento[]
  gatilhosReciclagem       GatilhoReciclagem[]
  funcoes                  Funcao[]
  sessoesTreinamento       SessaoTreinamento[]
  participacoesTreinamento ParticipacaoTreinamento[]

  @@map("empresa")
}

model ObraUnidade {
  id           String   @id @default(uuid()) @db.Uuid
  empresaId    String   @map("empresa_id") @db.Uuid
  nome         String
  codigo       String?
  endereco     String?
  segmento     String?
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  empresa             Empresa              @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  acessos             UsuarioAcessoObra[]
  rncs                Rnc[]
  planos              PlanoAcao[]
  configuracoesEscala ConfiguracaoEscala[]
  riscosOportunidades RiscoOportunidade[]
  linhasHira          LinhaHira[]
  linhasLaia          LinhaLaia[]
  documentos          Documento[]
  inspecoes           Inspecao[]
  auditorias          Auditoria[]
  incidentes          Incidente[]
  sessoesTreinamento  SessaoTreinamento[]

  @@unique([empresaId, id])
  @@unique([empresaId, nome])
  @@map("obra_unidade")
}

model Setor {
  id           String   @id @default(uuid()) @db.Uuid
  empresaId    String   @map("empresa_id") @db.Uuid
  nome         String
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  empresa    Empresa     @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  usuarios   Usuario[]
  rncs       Rnc[]
  documentos Documento[]
  inspecoes  Inspecao[]
  incidentes Incidente[]

  @@unique([empresaId, id])
  @@unique([empresaId, nome])
  @@map("setor")
}

/// Função/cargo do usuário (ex.: Eletricista, Montador de andaime). Base da obrigatoriedade de treinamentos por função.
model Funcao {
  id           String   @id @default(uuid()) @db.Uuid
  empresaId    String   @map("empresa_id") @db.Uuid
  nome         String
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  empresa  Empresa   @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  usuarios Usuario[]

  @@unique([empresaId, id])
  @@unique([empresaId, nome])
  @@map("funcao")
}

model Perfil {
  id           String      @id @default(uuid()) @db.Uuid
  empresaId    String      @map("empresa_id") @db.Uuid
  nome         String
  descricao    String?
  permissoes   Permissao[]
  sistema      Boolean     @default(false)
  criadoEm     DateTime    @default(now()) @map("criado_em")
  atualizadoEm DateTime    @updatedAt @map("atualizado_em")

  empresa  Empresa   @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  usuarios Usuario[]

  @@unique([empresaId, id])
  @@unique([empresaId, nome])
  @@map("perfil")
}

model Usuario {
  id           String       @id @default(uuid()) @db.Uuid
  empresaId    String       @map("empresa_id") @db.Uuid
  nome         String
  email        String       @unique
  senhaHash    String       @map("senha_hash")
  papel        PapelUsuario @default(COLABORADOR)
  perfilId     String?      @map("perfil_id") @db.Uuid
  setorId      String?      @map("setor_id") @db.Uuid
  funcaoId     String?      @map("funcao_id") @db.Uuid
  escopoObras  EscopoObras  @default(SELECIONADAS) @map("escopo_obras")
  tokenVersao  Int          @default(0) @map("token_versao")
  ativo        Boolean      @default(true)
  ultimoLogin  DateTime?    @map("ultimo_login")
  criadoEm     DateTime     @default(now()) @map("criado_em")
  atualizadoEm DateTime     @updatedAt @map("atualizado_em")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  perfil  Perfil? @relation(fields: [empresaId, perfilId], references: [empresaId, id], onDelete: Restrict)
  setor   Setor?  @relation(fields: [empresaId, setorId], references: [empresaId, id], onDelete: Restrict)
  funcao  Funcao? @relation(fields: [empresaId, funcaoId], references: [empresaId, id], onDelete: Restrict)

  acessosObra               UsuarioAcessoObra[]
  rncsAbertas               Rnc[]                        @relation("RncAbertoPor")
  rncsResponsavel           Rnc[]                        @relation("RncResponsavel")
  verificacoes              VerificacaoEficacia[]        @relation("VerificacaoVerificador")
  historicosStatus          HistoricoStatusRnc[]         @relation("HistoricoUsuario")
  cancelamentosSolicitados  SolicitacaoCancelamento[]    @relation("CancelamentoSolicitante")
  cancelamentosDecididos    SolicitacaoCancelamento[]    @relation("CancelamentoAprovador")
  planosCriados             PlanoAcao[]                  @relation("PlanoCriadoPor")
  itensResponsavel          ItemAcao[]                   @relation("ItemQuem")
  itensConcluidos           ItemAcao[]                   @relation("ItemConcluidoPor")
  anexosEnviados            Anexo[]                      @relation("AnexoEnviadoPor")
  anexosExcluidos           Anexo[]                      @relation("AnexoExcluidoPor")
  interacoesAutor           Interacao[]                  @relation("InteracaoAutor")
  interacoesDestinatario    Interacao[]                  @relation("InteracaoDestinatario")
  leiturasInteracao         LeituraInteracao[]
  notificacoes              Notificacao[]
  fluxosSolicitados         FluxoAprovacao[]             @relation("FluxoSolicitante")
  etapasAprovador           EtapaAprovacao[]             @relation("EtapaAprovador")
  historicosAprovacao       HistoricoAprovacao[]         @relation("HistoricoAprovacaoUsuario")
  processosDono             Processo[]                   @relation("ProcessoDono")
  versoesProcessoPublicadas VersaoProcesso[]             @relation("VersaoProcessoPublicadoPor")
  riscosResponsavel         RiscoOportunidade[]          @relation("RiscoResponsavel")
  riscosCriados             RiscoOportunidade[]          @relation("RiscoCriadoPor")
  historicosRisco           HistoricoRiscoOportunidade[] @relation("HistoricoRiscoUsuario")
  ciclosSwotCriados         CicloSwot[]                  @relation("CicloSwotCriadoPor")
  hiraResponsavel           LinhaHira[]                  @relation("HiraResponsavel")
  hiraCriadas               LinhaHira[]                  @relation("HiraCriadoPor")
  historicosHira            HistoricoLinhaHira[]         @relation("HistoricoHiraUsuario")
  laiaResponsavel           LinhaLaia[]                  @relation("LaiaResponsavel")
  laiaCriadas               LinhaLaia[]                  @relation("LaiaCriadoPor")
  historicosLaia            HistoricoLinhaLaia[]         @relation("HistoricoLaiaUsuario")
  documentosResponsavel     Documento[]                  @relation("DocumentoResponsavel")
  documentosCriados         Documento[]                  @relation("DocumentoCriadoPor")
  versoesDocElaboradas      VersaoDocumento[]            @relation("VersaoDocElaborador")
  versoesDocPublicadas      VersaoDocumento[]            @relation("VersaoDocPublicadoPor")
  publicacoesDocumento      PublicacaoDocumento[]        @relation("PublicacaoDocPublicadoPor")
  cienciasDocumento         CienciaDocumento[]           @relation("CienciaDocUsuario")
  historicosDocumento       HistoricoDocumento[]         @relation("HistoricoDocUsuario")
  modelosChecklistCriados   ModeloChecklist[]            @relation("ModeloChecklistCriadoPor")
  inspecoesInspetor         Inspecao[]                   @relation("InspecaoInspetor")
  programasAuditoriaCriados ProgramaAuditoria[]          @relation("ProgramaAuditoriaCriadoPor")
  auditoriasLider           Auditoria[]                  @relation("AuditoriaLider")
  auditoriasCriadas         Auditoria[]                  @relation("AuditoriaCriadoPor")
  constatacoesCriadas       Constatacao[]                @relation("ConstatacaoCriadoPor")
  incidentesEnvolvido       Incidente[]                  @relation("IncidenteEnvolvido")
  incidentesResponsavel     Incidente[]                  @relation("IncidenteResponsavel")
  incidentesRegistrados     Incidente[]                  @relation("IncidenteRegistradoPor")
  historicosIncidente       HistoricoIncidente[]         @relation("HistoricoIncidenteUsuario")
  indicadoresResponsavel    Indicador[]                  @relation("IndicadorResponsavel")
  indicadoresCriados        Indicador[]                  @relation("IndicadorCriadoPor")
  resultadosIndicador       ResultadoIndicador[]         @relation("ResultadoIndicadorRegistradoPor")
  treinamentosCriados       Treinamento[]                @relation("TreinamentoCriadoPor")
  sessoesTreinamentoCriadas SessaoTreinamento[]          @relation("SessaoTreinamentoCriadoPor")
  participacoesTreinamento  ParticipacaoTreinamento[]    @relation("ParticipacaoUsuario")
  participacoesRegistradas  ParticipacaoTreinamento[]    @relation("ParticipacaoRegistradoPor")
  eficaciasAvaliadas        ParticipacaoTreinamento[]    @relation("ParticipacaoAvaliadorEficacia")
  gatilhosReciclagem        GatilhoReciclagem[]          @relation("GatilhoUsuario")
  gatilhosRegistrados       GatilhoReciclagem[]          @relation("GatilhoRegistradoPor")

  @@unique([empresaId, id])
  @@index([empresaId, ativo])
  @@map("usuario")
}

model UsuarioAcessoObra {
  empresaId String   @map("empresa_id") @db.Uuid
  usuarioId String   @map("usuario_id") @db.Uuid
  obraId    String   @map("obra_id") @db.Uuid
  criadoEm  DateTime @default(now()) @map("criado_em")

  empresa Empresa     @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  usuario Usuario     @relation(fields: [empresaId, usuarioId], references: [empresaId, id], onDelete: Cascade)
  obra    ObraUnidade @relation(fields: [empresaId, obraId], references: [empresaId, id], onDelete: Restrict)

  @@id([empresaId, usuarioId, obraId])
  @@index([empresaId, obraId])
  @@map("usuario_acesso_obra")
}

model ContadorSequencial {
  empresaId   String        @map("empresa_id") @db.Uuid
  tipo        TipoSequencia
  ano         Int
  /// Subdivisão do contador (ex.: DOCUMENTO por tipo de documento = id do tipo). "" = sem subtipo (RNC).
  subtipo     String        @default("")
  ultimoValor Int           @default(0) @map("ultimo_valor")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  @@id([empresaId, tipo, ano, subtipo])
  @@map("contador_sequencial")
}

model Rnc {
  id                      String           @id @default(uuid()) @db.Uuid
  empresaId               String           @map("empresa_id") @db.Uuid
  ano                     Int
  sequencia               Int
  codigo                  String
  tipo                    TipoRnc
  origem                  OrigemRnc
  gravidade               Gravidade
  titulo                  String
  descricao               String
  dataAbertura            DateTime         @default(now()) @map("data_abertura")
  obraId                  String           @map("obra_id") @db.Uuid
  setorId                 String?          @map("setor_id") @db.Uuid
  processoArea            String?          @map("processo_area")
  abertoPorId             String           @map("aberto_por_id") @db.Uuid
  responsavelId           String?          @map("responsavel_id") @db.Uuid
  causaRaiz               String?          @map("causa_raiz")
  metodoCausaRaiz         MetodoCausaRaiz? @map("metodo_causa_raiz")
  analiseCausa            Json?            @map("analise_causa")
  status                  StatusRnc        @default(ABERTO)
  dataVerificacaoEficacia DateTime?        @map("data_verificacao_eficacia") @db.Date
  eficaz                  Boolean?
  restrita                Boolean          @default(false)
  contemDadosPessoais     Boolean          @default(false) @map("contem_dados_pessoais")
  planoAcaoId             String?          @map("plano_acao_id") @db.Uuid
  versao                  Int              @default(0)
  encerradoEm             DateTime?        @map("encerrado_em")
  canceladoEm             DateTime?        @map("cancelado_em")
  criadoEm                DateTime         @default(now()) @map("criado_em")
  atualizadoEm            DateTime         @updatedAt @map("atualizado_em")

  empresa     Empresa     @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  obra        ObraUnidade @relation(fields: [empresaId, obraId], references: [empresaId, id], onDelete: Restrict)
  setor       Setor?      @relation(fields: [empresaId, setorId], references: [empresaId, id], onDelete: Restrict)
  abertoPor   Usuario     @relation("RncAbertoPor", fields: [empresaId, abertoPorId], references: [empresaId, id], onDelete: Restrict)
  responsavel Usuario?    @relation("RncResponsavel", fields: [empresaId, responsavelId], references: [empresaId, id], onDelete: Restrict)
  planoAcao   PlanoAcao?  @relation(fields: [empresaId, planoAcaoId], references: [empresaId, id], onDelete: Restrict)

  dadosSensiveis           RncDadosSensiveis?
  verificacoes             VerificacaoEficacia[]
  historicoStatus          HistoricoStatusRnc[]
  solicitacoesCancelamento SolicitacaoCancelamento[]
  respostaInspecao         RespostaInspecao?
  constatacao              Constatacao?

  @@unique([empresaId, id])
  @@unique([empresaId, ano, sequencia])
  @@unique([empresaId, codigo])
  @@unique([empresaId, planoAcaoId])
  @@index([empresaId, status])
  @@index([empresaId, obraId, status])
  @@index([empresaId, responsavelId, status])
  @@index([empresaId, restrita])
  @@map("rnc")
}

