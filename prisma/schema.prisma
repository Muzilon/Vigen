  obraId               String              @map("obra_id") @db.Uuid
  processoId           String?             @map("processo_id") @db.Uuid
  atividade            String
  aspecto              String
  impacto              String
  situacao             CondicaoOperacional @default(NORMAL)
  temporalidade        Temporalidade       @default(ATUAL)
  incidencia           Incidencia          @default(DIRETA)
  severidade           Int
  frequencia           Int
  abrangencia          Int
  requisitoLegal       Boolean             @default(false) @map("requisito_legal")
  partesInteressadas   Boolean             @default(false) @map("partes_interessadas")
  score                Int
  faixa                FaixaNivel
  significativo        Boolean
  controles            String?
  responsavelId        String?             @map("responsavel_id") @db.Uuid
  planoAcaoId          String?             @map("plano_acao_id") @db.Uuid
  modoReavaliacao      ModoReavaliacao     @default(ITEM) @map("modo_reavaliacao")
  periodicidadeMeses   Int                 @default(12) @map("periodicidade_meses")
  proximaReavaliacaoEm DateTime?           @map("proxima_reavaliacao_em") @db.Date
  ultimaReavaliacaoEm  DateTime?           @map("ultima_reavaliacao_em")
  status               StatusLinhaSgi      @default(VIGENTE)
  versao               Int                 @default(0)
  criadoPorId          String              @map("criado_por_id") @db.Uuid
  criadoEm             DateTime            @default(now()) @map("criado_em")
  atualizadoEm         DateTime            @updatedAt @map("atualizado_em")

  empresa     Empresa              @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  obra        ObraUnidade          @relation(fields: [empresaId, obraId], references: [empresaId, id], onDelete: Restrict)
  processo    Processo?            @relation(fields: [empresaId, processoId], references: [empresaId, id], onDelete: Restrict)
  responsavel Usuario?             @relation("LaiaResponsavel", fields: [empresaId, responsavelId], references: [empresaId, id], onDelete: Restrict)
  criadoPor   Usuario              @relation("LaiaCriadoPor", fields: [empresaId, criadoPorId], references: [empresaId, id], onDelete: Restrict)
  planoAcao   PlanoAcao?           @relation(fields: [empresaId, planoAcaoId], references: [empresaId, id], onDelete: Restrict)
  historico   HistoricoLinhaLaia[]

  @@unique([empresaId, id])
  @@unique([empresaId, numero])
  @@unique([empresaId, planoAcaoId])
  @@index([empresaId, obraId, status])
  @@index([empresaId, processoId])
  @@index([empresaId, proximaReavaliacaoEm])
  @@map("linha_laia")
}

/// Histórico append-only da linha LAIA (trigger bloqueia UPDATE/DELETE).
model HistoricoLinhaLaia {
  id         String           @id @default(uuid()) @db.Uuid
  empresaId  String           @map("empresa_id") @db.Uuid
  linhaId    String           @map("linha_id") @db.Uuid
  acao       AcaoHistoricoSgi
  versao     Int
  dados      Json
  observacao String?
  usuarioId  String           @map("usuario_id") @db.Uuid
  criadoEm   DateTime         @default(now()) @map("criado_em")

  empresa Empresa   @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  linha   LinhaLaia @relation(fields: [empresaId, linhaId], references: [empresaId, id], onDelete: Restrict)
  usuario Usuario   @relation("HistoricoLaiaUsuario", fields: [empresaId, usuarioId], references: [empresaId, id], onDelete: Restrict)

  @@unique([empresaId, id])
  @@index([empresaId, linhaId, criadoEm])
  @@map("historico_linha_laia")
}

model TentativaLogin {
  id        String   @id @default(uuid()) @db.Uuid
  email     String
  ip        String
  sucesso   Boolean
  bloqueada Boolean  @default(false)
  criadoEm  DateTime @default(now()) @map("criado_em")

  @@index([email, criadoEm])
  @@index([ip, criadoEm])
  @@map("tentativa_login")
}

// ============================================================== P4 — Tramitação de Documentos (ISO 9001 7.5)

/// Ciclo do documento (reflete a revisão em trabalho; a revisão vigente fica em versaoVigenteId):
/// ELABORACAO → EM_REVISAO (revisores assinando) → EM_APROVACAO (aprovadores) → APROVADO (pronto p/ publicar)
/// → PUBLICADO. OBSOLETO (retirado de uso) e CANCELADO (nunca publicado) são finais.
enum StatusDocumento {
  ELABORACAO
  EM_REVISAO
  EM_APROVACAO
  APROVADO
  PUBLICADO
  OBSOLETO
  CANCELADO
}

/// Revisão de um documento. PUBLICADA/OBSOLETA são imutáveis (trigger; só PUBLICADA → OBSOLETA).
/// Rejeição no fluxo devolve a revisão para RASCUNHO.
enum StatusVersaoDocumento {
  RASCUNHO
  EM_APROVACAO
  APROVADA
  PUBLICADA
  OBSOLETA
  CANCELADA
}

enum AcaoHistoricoDocumento {
  CRIACAO
  ALTERACAO_DADOS
  EDICAO
  NOVA_REVISAO
  ARQUIVO_SUBSTITUIDO
  ENVIO_APROVACAO
  REVISADO
  APROVACAO
  REJEICAO
  CANCELAMENTO_APROVACAO
  PUBLICACAO
  OBSOLESCENCIA
  CANCELAMENTO
  REVISAO_PLANILHA
}

/// Tipos de documento configuráveis por empresa (PR, IT, FO, POL, MAN...). A sigla compõe o código.
model TipoDocumentoEmpresa {
  id                        String   @id @default(uuid()) @db.Uuid
  empresaId                 String   @map("empresa_id") @db.Uuid
  nome                      String
  sigla                     String
  periodicidadeRevisaoMeses Int      @default(24) @map("periodicidade_revisao_meses")
  ativo                     Boolean  @default(true)
  criadoEm                  DateTime @default(now()) @map("criado_em")
  atualizadoEm              DateTime @updatedAt @map("atualizado_em")

  empresa    Empresa     @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  documentos Documento[]

  @@unique([empresaId, id])
  @@unique([empresaId, sigla])
  @@unique([empresaId, nome])
  @@map("tipo_documento_empresa")
}

/// Documento controlado. Código = sigla do tipo + sequência por tipo (ContadorSequencial DOCUMENTO,
/// subtipo = id do tipo). chavePlanilha: documento-planilha de HIRA/LAIA (integração, decisão 5).
model Documento {
  id                        String          @id @default(uuid()) @db.Uuid
  empresaId                 String          @map("empresa_id") @db.Uuid
  tipoId                    String          @map("tipo_id") @db.Uuid
  sequencia                 Int
  codigo                    String
  titulo                    String
  descricao                 String?
  processoId                String?         @map("processo_id") @db.Uuid
  obraId                    String?         @map("obra_id") @db.Uuid
  setorId                   String?         @map("setor_id") @db.Uuid
  responsavelId             String          @map("responsavel_id") @db.Uuid
  status                    StatusDocumento @default(ELABORACAO)
  versaoVigenteId           String?         @map("versao_vigente_id") @db.Uuid
  periodicidadeRevisaoMeses Int             @map("periodicidade_revisao_meses")
  proximaRevisaoEm          DateTime?       @map("proxima_revisao_em") @db.Date
  chavePlanilha             String?         @map("chave_planilha")
  versao                    Int             @default(0)
  criadoPorId               String          @map("criado_por_id") @db.Uuid
  criadoEm                  DateTime        @default(now()) @map("criado_em")
  atualizadoEm              DateTime        @updatedAt @map("atualizado_em")

  empresa       Empresa               @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  tipo          TipoDocumentoEmpresa  @relation(fields: [empresaId, tipoId], references: [empresaId, id], onDelete: Restrict)
  processo      Processo?             @relation(fields: [empresaId, processoId], references: [empresaId, id], onDelete: Restrict)
  obra          ObraUnidade?          @relation(fields: [empresaId, obraId], references: [empresaId, id], onDelete: Restrict)
  setor         Setor?                @relation(fields: [empresaId, setorId], references: [empresaId, id], onDelete: Restrict)
  responsavel   Usuario               @relation("DocumentoResponsavel", fields: [empresaId, responsavelId], references: [empresaId, id], onDelete: Restrict)
  criadoPor     Usuario               @relation("DocumentoCriadoPor", fields: [empresaId, criadoPorId], references: [empresaId, id], onDelete: Restrict)
  versaoVigente VersaoDocumento?      @relation("DocumentoVersaoVigente", fields: [empresaId, versaoVigenteId], references: [empresaId, id], onDelete: Restrict)
  versoes       VersaoDocumento[]     @relation("DocumentoVersoes")
  publicacoes   PublicacaoDocumento[]
  historico     HistoricoDocumento[]
  treinamentos  Treinamento[]

  @@unique([empresaId, id])
  @@unique([empresaId, codigo])
  @@unique([empresaId, tipoId, sequencia])
  @@unique([empresaId, versaoVigenteId])
  @@unique([empresaId, chavePlanilha])
  @@index([empresaId, status])
  @@index([empresaId, processoId])
  @@index([empresaId, proximaRevisaoEm])
  @@map("documento")
}

/// Revisão (00, 01, ...). Arquivo via Anexo DOCUMENTO_VERSAO; revisão de planilha HIRA/LAIA guarda o
/// snapshot em `conteudo`. Imutável depois de publicada (trigger).
model VersaoDocumento {
  id               String                @id @default(uuid()) @db.Uuid
  empresaId        String                @map("empresa_id") @db.Uuid
  documentoId      String                @map("documento_id") @db.Uuid
  numero           Int
  motivo           String
  status           StatusVersaoDocumento @default(RASCUNHO)
  elaboradorId     String                @map("elaborador_id") @db.Uuid
  anexoId          String?               @map("anexo_id") @db.Uuid
  conteudo         Json?
  fluxoAprovacaoId String?               @map("fluxo_aprovacao_id") @db.Uuid
  aprovadoEm       DateTime?             @map("aprovado_em")
  publicadoEm      DateTime?             @map("publicado_em")
  publicadoPorId   String?               @map("publicado_por_id") @db.Uuid
  obsoletoEm       DateTime?             @map("obsoleto_em")
  criadoEm         DateTime              @default(now()) @map("criado_em")

  empresa        Empresa              @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  documento      Documento            @relation("DocumentoVersoes", fields: [empresaId, documentoId], references: [empresaId, id], onDelete: Restrict)
  elaborador     Usuario              @relation("VersaoDocElaborador", fields: [empresaId, elaboradorId], references: [empresaId, id], onDelete: Restrict)
  publicadoPor   Usuario?             @relation("VersaoDocPublicadoPor", fields: [empresaId, publicadoPorId], references: [empresaId, id], onDelete: Restrict)
  anexo          Anexo?               @relation(fields: [empresaId, anexoId], references: [empresaId, id], onDelete: Restrict)
  fluxoAprovacao FluxoAprovacao?      @relation(fields: [empresaId, fluxoAprovacaoId], references: [empresaId, id], onDelete: Restrict)
  vigenteDe      Documento?           @relation("DocumentoVersaoVigente")
  publicacao     PublicacaoDocumento?
  ciencias       CienciaDocumento[]
  historico      HistoricoDocumento[]

  @@unique([empresaId, id])
  @@unique([empresaId, documentoId, numero])
  @@index([empresaId, status])
  @@map("versao_documento")
}

/// Publicação de uma revisão: público (todos ou listas de setores/obras/perfis/usuários — união),
/// se notifica e se exige ciência ("li e estou ciente"). Append-only (trigger).
model PublicacaoDocumento {
  id               String   @id @default(uuid()) @db.Uuid
  empresaId        String   @map("empresa_id") @db.Uuid
  documentoId      String   @map("documento_id") @db.Uuid
  versaoId         String   @map("versao_id") @db.Uuid
  publicoTodos     Boolean  @default(false) @map("publico_todos")
  setorIds         String[] @map("setor_ids") @db.Uuid
  obraIds          String[] @map("obra_ids") @db.Uuid
  perfilIds        String[] @map("perfil_ids") @db.Uuid
  usuarioIds       String[] @map("usuario_ids") @db.Uuid
  notificar        Boolean  @default(true)
  exigirCiencia    Boolean  @default(false) @map("exigir_ciencia")
  /// Micro-quiz de ciência de leitura (opcional, até 3 perguntas): Array<{ pergunta, opcoes: string[], correta: number }>.
  perguntasCiencia Json?    @map("perguntas_ciencia")
  publicadoPorId   String   @map("publicado_por_id") @db.Uuid
  publicadoEm      DateTime @default(now()) @map("publicado_em")

  empresa      Empresa         @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  documento    Documento       @relation(fields: [empresaId, documentoId], references: [empresaId, id], onDelete: Restrict)
  versao       VersaoDocumento @relation(fields: [empresaId, versaoId], references: [empresaId, id], onDelete: Restrict)
  publicadoPor Usuario         @relation("PublicacaoDocPublicadoPor", fields: [empresaId, publicadoPorId], references: [empresaId, id], onDelete: Restrict)

  @@unique([empresaId, id])
  @@unique([empresaId, versaoId])
  @@index([empresaId, documentoId])
  @@map("publicacao_documento")
}

/// Ciência ("li e estou ciente") de um usuário numa revisão publicada. Append-only (trigger).
model CienciaDocumento {
  id           String   @id @default(uuid()) @db.Uuid
  empresaId    String   @map("empresa_id") @db.Uuid
  versaoId     String   @map("versao_id") @db.Uuid
  usuarioId    String   @map("usuario_id") @db.Uuid
  confirmadoEm DateTime @default(now()) @map("confirmado_em")

  empresa Empresa         @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  versao  VersaoDocumento @relation(fields: [empresaId, versaoId], references: [empresaId, id], onDelete: Restrict)
  usuario Usuario         @relation("CienciaDocUsuario", fields: [empresaId, usuarioId], references: [empresaId, id], onDelete: Restrict)

  @@unique([empresaId, id])
  @@unique([empresaId, versaoId, usuarioId])
  @@index([empresaId, usuarioId])
  @@map("ciencia_documento")
}

/// Histórico append-only do documento (trigger bloqueia UPDATE/DELETE).
model HistoricoDocumento {
  id          String                 @id @default(uuid()) @db.Uuid
  empresaId   String                 @map("empresa_id") @db.Uuid
  documentoId String                 @map("documento_id") @db.Uuid
  versaoId    String?                @map("versao_id") @db.Uuid
  acao        AcaoHistoricoDocumento
  observacao  String?
  dados       Json?
  usuarioId   String                 @map("usuario_id") @db.Uuid
  criadoEm    DateTime               @default(now()) @map("criado_em")

  empresa   Empresa          @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  documento Documento        @relation(fields: [empresaId, documentoId], references: [empresaId, id], onDelete: Restrict)
  versao    VersaoDocumento? @relation(fields: [empresaId, versaoId], references: [empresaId, id], onDelete: Restrict)
  usuario   Usuario          @relation("HistoricoDocUsuario", fields: [empresaId, usuarioId], references: [empresaId, id], onDelete: Restrict)

  @@unique([empresaId, id])
  @@index([empresaId, documentoId, criadoEm])
  @@map("historico_documento")
}

// ============================================================ P5 — Inspeções / Checklists

enum TipoChecklist {
  QUALIDADE
  SSO
  MEIO_AMBIENTE
  GERAL
}

/// Tipo de resposta de um item do checklist.
/// CONFORME_NAO_CONFORME_NA: C / NC / N/A. SIM_NAO: pergunta formulada no positivo (NÃO = não conforme).
/// NOTA_1A5: nota abaixo de ModeloChecklist.notaMinima = não conforme. TEXTO: livre, fora do % de conformidade.
enum TipoRespostaChecklist {
  CONFORME_NAO_CONFORME_NA
  SIM_NAO
  NOTA_1A5
  TEXTO
}

enum ValorRespostaInspecao {
  CONFORME
  NAO_CONFORME
  NAO_APLICAVEL
  SIM
  NAO
}

enum StatusInspecao {
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

/// Modelo de checklist (INSPECAO_GERENCIAR). Itens inativados continuam nas inspeções já feitas (snapshot na resposta).
model ModeloChecklist {
  id           String        @id @default(uuid()) @db.Uuid
  empresaId    String        @map("empresa_id") @db.Uuid
  nome         String
  descricao    String?
  tipo         TipoChecklist @default(GERAL)
  /// NOTA_1A5: nota < notaMinima conta como não conforme.
  notaMinima   Int           @default(3) @map("nota_minima")
  ativo        Boolean       @default(true)
  /// Trava otimista.
  versao       Int           @default(0)
  criadoPorId  String        @map("criado_por_id") @db.Uuid
  criadoEm     DateTime      @default(now()) @map("criado_em")
  atualizadoEm DateTime      @updatedAt @map("atualizado_em")

  empresa   Empresa               @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  criadoPor Usuario               @relation("ModeloChecklistCriadoPor", fields: [empresaId, criadoPorId], references: [empresaId, id], onDelete: Restrict)
  itens     ItemModeloChecklist[]
  inspecoes Inspecao[]

  @@unique([empresaId, id])
  @@unique([empresaId, nome])
  @@map("modelo_checklist")
}

model ItemModeloChecklist {
  id              String                @id @default(uuid()) @db.Uuid
  empresaId       String                @map("empresa_id") @db.Uuid
  modeloId        String                @map("modelo_id") @db.Uuid
  ordem           Int
  pergunta        String
  tipoResposta    TipoRespostaChecklist @map("tipo_resposta")
  /// Foto exigida quando a resposta for não conforme (evidência da NC).
  obrigatorioFoto Boolean               @default(false) @map("obrigatorio_foto")
  /// Critério de aceitação / texto de ajuda.
  ajuda           String?
  ativo           Boolean               @default(true)
  criadoEm        DateTime              @default(now()) @map("criado_em")

  empresa   Empresa            @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  modelo    ModeloChecklist    @relation(fields: [empresaId, modeloId], references: [empresaId, id], onDelete: Restrict)
  respostas RespostaInspecao[]

  @@unique([empresaId, id])
  @@index([empresaId, modeloId, ordem])
  @@map("item_modelo_checklist")
}

/// Inspeção de campo (código INSP-NNN-AA). Obra obrigatória = escopo.
model Inspecao {
  id                     String         @id @default(uuid()) @db.Uuid
  empresaId              String         @map("empresa_id") @db.Uuid
  ano                    Int
  sequencia              Int
  codigo                 String
  modeloId               String         @map("modelo_id") @db.Uuid
  obraId                 String         @map("obra_id") @db.Uuid
  setorId                String?        @map("setor_id") @db.Uuid
  processoId             String?        @map("processo_id") @db.Uuid
  inspetorId             String         @map("inspetor_id") @db.Uuid
  dataInspecao           DateTime       @map("data_inspecao") @db.Date
  status                 StatusInspecao @default(EM_ANDAMENTO)
  observacoes            String?
  /// Gravado ao concluir: conformes / (conformes + não conformes), 0–100.
  percentualConformidade Int?           @map("percentual_conformidade")
  concluidaEm            DateTime?      @map("concluida_em")
  /// Plano (origem INSPECAO) que recebe os itens de ação criados a partir das respostas.
  planoAcaoId            String?        @map("plano_acao_id") @db.Uuid
  versao                 Int            @default(0)
  criadoEm               DateTime       @default(now()) @map("criado_em")
  atualizadoEm           DateTime       @updatedAt @map("atualizado_em")

  empresa   Empresa            @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  modelo    ModeloChecklist    @relation(fields: [empresaId, modeloId], references: [empresaId, id], onDelete: Restrict)
  obra      ObraUnidade        @relation(fields: [empresaId, obraId], references: [empresaId, id], onDelete: Restrict)
  setor     Setor?             @relation(fields: [empresaId, setorId], references: [empresaId, id], onDelete: Restrict)
  processo  Processo?          @relation(fields: [empresaId, processoId], references: [empresaId, id], onDelete: Restrict)
  inspetor  Usuario            @relation("InspecaoInspetor", fields: [empresaId, inspetorId], references: [empresaId, id], onDelete: Restrict)
  planoAcao PlanoAcao?         @relation(fields: [empresaId, planoAcaoId], references: [empresaId, id], onDelete: Restrict)
  respostas RespostaInspecao[]

  @@unique([empresaId, id])
  @@unique([empresaId, ano, sequencia])
  @@unique([empresaId, codigo])
  @@unique([empresaId, planoAcaoId])
  @@index([empresaId, obraId, status])
  @@index([empresaId, modeloId])
  @@index([empresaId, dataInspecao])
  @@map("inspecao")
}

/// Resposta de um item: criada (vazia) ao iniciar a inspeção, com snapshot da pergunta do modelo.
model RespostaInspecao {
  id               String                 @id @default(uuid()) @db.Uuid
  empresaId        String                 @map("empresa_id") @db.Uuid
  inspecaoId       String                 @map("inspecao_id") @db.Uuid
  itemModeloId     String                 @map("item_modelo_id") @db.Uuid
  ordem            Int
  pergunta         String
  tipoResposta     TipoRespostaChecklist  @map("tipo_resposta")
  obrigatorioFoto  Boolean                @default(false) @map("obrigatorio_foto")
  ajuda            String?
  resposta         ValorRespostaInspecao?
  nota             Int?
  texto            String?
  comentario       String?
  respondidoEm     DateTime?              @map("respondido_em")
  geradaRncId      String?                @map("gerada_rnc_id") @db.Uuid
  geradoItemAcaoId String?                @map("gerado_item_acao_id") @db.Uuid

  empresa        Empresa             @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  inspecao       Inspecao            @relation(fields: [empresaId, inspecaoId], references: [empresaId, id], onDelete: Restrict)
  itemModelo     ItemModeloChecklist @relation(fields: [empresaId, itemModeloId], references: [empresaId, id], onDelete: Restrict)
  geradaRnc      Rnc?                @relation(fields: [empresaId, geradaRncId], references: [empresaId, id], onDelete: Restrict)
  geradoItemAcao ItemAcao?           @relation(fields: [empresaId, geradoItemAcaoId], references: [empresaId, id], onDelete: Restrict)

  @@unique([empresaId, id])
  @@unique([empresaId, inspecaoId, itemModeloId])
  @@unique([empresaId, geradaRncId])
  @@unique([empresaId, geradoItemAcaoId])
  @@index([empresaId, inspecaoId, ordem])
  @@map("resposta_inspecao")
}

// ============================================================ P5 — Auditorias internas

enum TipoAuditoria {
  INTERNA
  EXTERNA_CERTIFICACAO
}

enum StatusAuditoria {
  PLANEJADA
  EM_EXECUCAO
  CONCLUIDA
  CANCELADA
}

enum TipoConstatacao {
  NAO_CONFORMIDADE
  OBSERVACAO
  OPORTUNIDADE_MELHORIA
  PONTO_FORTE
}

/// Programa anual de auditorias (um por ano).
model ProgramaAuditoria {
  id           String   @id @default(uuid()) @db.Uuid
  empresaId    String   @map("empresa_id") @db.Uuid
  ano          Int
  objetivo     String
  criadoPorId  String   @map("criado_por_id") @db.Uuid
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  empresa    Empresa     @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  criadoPor  Usuario     @relation("ProgramaAuditoriaCriadoPor", fields: [empresaId, criadoPorId], references: [empresaId, id], onDelete: Restrict)
  auditorias Auditoria[]

  @@unique([empresaId, id])
  @@unique([empresaId, ano])
  @@map("programa_auditoria")
}

/// Auditoria (código AUD-NNN-AA). Obra opcional (sem obra = empresa toda); com obra, entra no escopo por obra.
model Auditoria {
  id             String          @id @default(uuid()) @db.Uuid
  empresaId      String          @map("empresa_id") @db.Uuid
  ano            Int
  sequencia      Int
  codigo         String
  programaId     String?         @map("programa_id") @db.Uuid
  tipo           TipoAuditoria   @default(INTERNA)
  norma          String
  escopo         String
  processoId     String?         @map("processo_id") @db.Uuid
  obraId         String?         @map("obra_id") @db.Uuid
  auditorLiderId String          @map("auditor_lider_id") @db.Uuid
  equipe         String?
  dataInicio     DateTime        @map("data_inicio") @db.Date
  dataFim        DateTime        @map("data_fim") @db.Date
  status         StatusAuditoria @default(PLANEJADA)
  conclusao      String?
  concluidaEm    DateTime?       @map("concluida_em")
  versao         Int             @default(0)
  criadoPorId    String          @map("criado_por_id") @db.Uuid
  criadoEm       DateTime        @default(now()) @map("criado_em")
  atualizadoEm   DateTime        @updatedAt @map("atualizado_em")

  empresa      Empresa            @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  programa     ProgramaAuditoria? @relation(fields: [empresaId, programaId], references: [empresaId, id], onDelete: Restrict)
  processo     Processo?          @relation(fields: [empresaId, processoId], references: [empresaId, id], onDelete: Restrict)
  obra         ObraUnidade?       @relation(fields: [empresaId, obraId], references: [empresaId, id], onDelete: Restrict)
  auditorLider Usuario            @relation("AuditoriaLider", fields: [empresaId, auditorLiderId], references: [empresaId, id], onDelete: Restrict)
  criadoPor    Usuario            @relation("AuditoriaCriadoPor", fields: [empresaId, criadoPorId], references: [empresaId, id], onDelete: Restrict)
  itens        ItemAuditoria[]
  constatacoes Constatacao[]

  @@unique([empresaId, id])
  @@unique([empresaId, ano, sequencia])
  @@unique([empresaId, codigo])
  @@index([empresaId, status])
  @@index([empresaId, programaId])
  @@map("auditoria")
}

/// Item do plano de auditoria: requisito/cláusula e pergunta/critério.
model ItemAuditoria {
  id          String   @id @default(uuid()) @db.Uuid
  empresaId   String   @map("empresa_id") @db.Uuid
  auditoriaId String   @map("auditoria_id") @db.Uuid
  ordem       Int
  requisito   String
  pergunta    String?
  criadoEm    DateTime @default(now()) @map("criado_em")

  empresa      Empresa       @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  auditoria    Auditoria     @relation(fields: [empresaId, auditoriaId], references: [empresaId, id], onDelete: Restrict)
  constatacoes Constatacao[]

  @@unique([empresaId, id])
  @@index([empresaId, auditoriaId, ordem])
  @@map("item_auditoria")
}

model Constatacao {
  id              String          @id @default(uuid()) @db.Uuid
  empresaId       String          @map("empresa_id") @db.Uuid
  auditoriaId     String          @map("auditoria_id") @db.Uuid
  itemAuditoriaId String?         @map("item_auditoria_id") @db.Uuid
  tipo            TipoConstatacao
  descricao       String
  evidencia       String?
  geradaRncId     String?         @map("gerada_rnc_id") @db.Uuid
  criadoPorId     String          @map("criado_por_id") @db.Uuid
  criadoEm        DateTime        @default(now()) @map("criado_em")

  empresa       Empresa        @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  auditoria     Auditoria      @relation(fields: [empresaId, auditoriaId], references: [empresaId, id], onDelete: Restrict)
  itemAuditoria ItemAuditoria? @relation(fields: [empresaId, itemAuditoriaId], references: [empresaId, id], onDelete: Restrict)
  geradaRnc     Rnc?           @relation(fields: [empresaId, geradaRncId], references: [empresaId, id], onDelete: Restrict)
  criadoPor     Usuario        @relation("ConstatacaoCriadoPor", fields: [empresaId, criadoPorId], references: [empresaId, id], onDelete: Restrict)

  @@unique([empresaId, id])
  @@unique([empresaId, geradaRncId])
  @@index([empresaId, auditoriaId, tipo])
  @@map("constatacao")
}

// ---------------------------------------------------------------- P6 — Incidentes e acidentes (ISO 45001 10.2)

enum TipoIncidente {
  ACIDENTE_TIPICO
  ACIDENTE_TRAJETO
  QUASE_ACIDENTE
  DOENCA_OCUPACIONAL
}

enum GravidadeIncidente {
  SEM_AFASTAMENTO
  COM_AFASTAMENTO
  FATALIDADE
}

enum StatusIncidente {
  ABERTO
  EM_INVESTIGACAO
  CONCLUIDO
}

enum AcaoHistoricoIncidente {
  REGISTRO
  ALTERACAO
  INVESTIGACAO
  STATUS
  PLANO
  RESPONSAVEL
}

/// Incidente/acidente de trabalho. Código INC-NNN-AA. Obra obrigatória (escopo). restrita (LGPD) = true quando há
/// envolvido/terceiro/testemunhas/dados sensíveis: só quem tem INCIDENTE_VER_RESTRITOS (ou registrou/investiga) vê.
model Incidente {
  id                  String             @id @default(uuid()) @db.Uuid
  empresaId           String             @map("empresa_id") @db.Uuid
  ano                 Int
  sequencia           Int
  codigo              String
  tipo                TipoIncidente
  gravidade           GravidadeIncidente
  dataHora            DateTime           @map("data_hora")
  obraId              String             @map("obra_id") @db.Uuid
  setorId             String?            @map("setor_id") @db.Uuid
  local               String?
  descricaoFatos      String             @map("descricao_fatos")
  /// Envolvido usuário do sistema OU terceiro (nome/função em texto) — nunca os dois (CHECK).
  envolvidoId         String?            @map("envolvido_id") @db.Uuid
  terceiroNome        String?            @map("terceiro_nome")
  terceiroFuncao      String?            @map("terceiro_funcao")
  testemunhas         String?
  status              StatusIncidente    @default(ABERTO)
  responsavelId       String?            @map("responsavel_id") @db.Uuid
  causaRaiz           String?            @map("causa_raiz")
  metodoCausaRaiz     MetodoCausaRaiz?   @map("metodo_causa_raiz")
  analiseCausa        Json?              @map("analise_causa")
  conclusao           String?
  planoAcaoId         String?            @map("plano_acao_id") @db.Uuid
  restrita            Boolean            @default(false)
  contemDadosPessoais Boolean            @default(false) @map("contem_dados_pessoais")
  diasPerdidos        Int?               @map("dias_perdidos")
  geraCat             Boolean            @default(false) @map("gera_cat")
  numeroCat           String?            @map("numero_cat")
  versao              Int                @default(0)
  registradoPorId     String             @map("registrado_por_id") @db.Uuid
  concluidoEm         DateTime?          @map("concluido_em")
  criadoEm            DateTime           @default(now()) @map("criado_em")
  atualizadoEm        DateTime           @updatedAt @map("atualizado_em")

  empresa        Empresa                  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  obra           ObraUnidade              @relation(fields: [empresaId, obraId], references: [empresaId, id], onDelete: Restrict)
  setor          Setor?                   @relation(fields: [empresaId, setorId], references: [empresaId, id], onDelete: Restrict)
  envolvido      Usuario?                 @relation("IncidenteEnvolvido", fields: [empresaId, envolvidoId], references: [empresaId, id], onDelete: Restrict)
  responsavel    Usuario?                 @relation("IncidenteResponsavel", fields: [empresaId, responsavelId], references: [empresaId, id], onDelete: Restrict)
  registradoPor  Usuario                  @relation("IncidenteRegistradoPor", fields: [empresaId, registradoPorId], references: [empresaId, id], onDelete: Restrict)
  planoAcao      PlanoAcao?               @relation(fields: [empresaId, planoAcaoId], references: [empresaId, id], onDelete: Restrict)
  dadosSensiveis IncidenteDadosSensiveis?
  historico      HistoricoIncidente[]

  @@unique([empresaId, id])
  @@unique([empresaId, ano, sequencia])
  @@unique([empresaId, codigo])
  @@unique([empresaId, planoAcaoId])
  @@index([empresaId, obraId, status])
  @@index([empresaId, dataHora])
  @@index([empresaId, restrita])
  @@map("incidente")
}

/// Dados pessoais do incidente (LGPD) — mesmo padrão de RncDadosSensiveis; só com INCIDENTE_VER_RESTRITOS.
model IncidenteDadosSensiveis {
  id                 String   @id @default(uuid()) @db.Uuid
  empresaId          String   @map("empresa_id") @db.Uuid
  incidenteId        String   @map("incidente_id") @db.Uuid
  nomeEnvolvido      String?  @map("nome_envolvido")
  documentoEnvolvido String?  @map("documento_envolvido")
  funcaoEnvolvido    String?  @map("funcao_envolvido")
  relato             String?
  lesaoDescricao     String?  @map("lesao_descricao")
  testemunhasRelato  String?  @map("testemunhas_relato")
  criadoEm           DateTime @default(now()) @map("criado_em")
  atualizadoEm       DateTime @updatedAt @map("atualizado_em")

  empresa   Empresa   @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  incidente Incidente @relation(fields: [empresaId, incidenteId], references: [empresaId, id], onDelete: Restrict)

  @@unique([empresaId, id])
  @@unique([empresaId, incidenteId])
  @@map("incidente_dados_sensiveis")
}

/// Append-only (trigger). Observações nunca levam dados pessoais.
model HistoricoIncidente {
  id             String                 @id @default(uuid()) @db.Uuid
  empresaId      String                 @map("empresa_id") @db.Uuid
  incidenteId    String                 @map("incidente_id") @db.Uuid
  acao           AcaoHistoricoIncidente
  statusAnterior StatusIncidente?       @map("status_anterior")
  statusNovo     StatusIncidente        @map("status_novo")
  observacao     String?
  usuarioId      String                 @map("usuario_id") @db.Uuid
  criadoEm       DateTime               @default(now()) @map("criado_em")

  empresa   Empresa   @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  incidente Incidente @relation(fields: [empresaId, incidenteId], references: [empresaId, id], onDelete: Restrict)
  usuario   Usuario   @relation("HistoricoIncidenteUsuario", fields: [empresaId, usuarioId], references: [empresaId, id], onDelete: Restrict)

  @@unique([empresaId, id])
  @@index([empresaId, incidenteId, criadoEm])
  @@map("historico_incidente")
}

// ---------------------------------------------------------------- P7 — Indicadores (ISO 9001 9.1)

enum DirecaoIndicador {
  MAIOR_MELHOR
  MENOR_MELHOR
}

enum PeriodicidadeIndicador {
  MENSAL
  TRIMESTRAL
  SEMESTRAL
  ANUAL
}

/// MANUAL: o responsável lança o valor. Demais: calculado dos dados reais do sistema (src/lib/indicadores/automaticos.ts).
enum FonteIndicador {
  MANUAL
  RNC_EFICACIA_PRIMEIRA_VERIFICACAO
  PLANO_ITENS_ATRASADOS
}

/// Indicador formal com meta e periodicidade (difere de IndicadorProcesso, que é só texto no SIPOC).
model Indicador {
  id            String                 @id @default(uuid()) @db.Uuid
  empresaId     String                 @map("empresa_id") @db.Uuid
  nome          String
  descricao     String?
  processoId    String?                @map("processo_id") @db.Uuid
  unidade       String
  direcao       DirecaoIndicador
  meta          Decimal                @db.Decimal(14, 4)
  periodicidade PeriodicidadeIndicador
  fonte         FonteIndicador         @default(MANUAL)
  formula       String?
  responsavelId String?                @map("responsavel_id") @db.Uuid
  ativo         Boolean                @default(true)
  versao        Int                    @default(0)
  criadoPorId   String                 @map("criado_por_id") @db.Uuid
  criadoEm      DateTime               @default(now()) @map("criado_em")
  atualizadoEm  DateTime               @updatedAt @map("atualizado_em")

  empresa     Empresa              @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  processo    Processo?            @relation(fields: [empresaId, processoId], references: [empresaId, id], onDelete: Restrict)
  responsavel Usuario?             @relation("IndicadorResponsavel", fields: [empresaId, responsavelId], references: [empresaId, id], onDelete: Restrict)
  criadoPor   Usuario              @relation("IndicadorCriadoPor", fields: [empresaId, criadoPorId], references: [empresaId, id], onDelete: Restrict)
  resultados  ResultadoIndicador[]

  @@unique([empresaId, id])
  @@unique([empresaId, nome])
  @@index([empresaId, processoId])
  @@index([empresaId, responsavelId])
  @@map("indicador")
}

/// Resultado de um período. Append-only (trigger): correção = novo lançamento do mesmo período (o mais recente vale).
/// `meta`/`direcao` são cópia do indicador no momento do lançamento (a meta pode mudar depois).
model ResultadoIndicador {
  id              String           @id @default(uuid()) @db.Uuid
  empresaId       String           @map("empresa_id") @db.Uuid
  indicadorId     String           @map("indicador_id") @db.Uuid
  periodo         String
  valor           Decimal          @db.Decimal(14, 4)
  meta            Decimal          @db.Decimal(14, 4)
  direcao         DirecaoIndicador
  automatico      Boolean          @default(false)
  observacao      String?
  registradoPorId String           @map("registrado_por_id") @db.Uuid
  criadoEm        DateTime         @default(now()) @map("criado_em")

  empresa       Empresa   @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  indicador     Indicador @relation(fields: [empresaId, indicadorId], references: [empresaId, id], onDelete: Restrict)
  registradoPor Usuario   @relation("ResultadoIndicadorRegistradoPor", fields: [empresaId, registradoPorId], references: [empresaId, id], onDelete: Restrict)

  @@unique([empresaId, id])
  @@index([empresaId, indicadorId, periodo, criadoEm])
  @@map("resultado_indicador")
}

// ---------------------------------------------------------------- P7 — Treinamentos e competências (ISO 9001 7.2/7.3, ISO 45001 7.2)

enum TipoTreinamento {
  INTEGRACAO
  NR
  RECICLAGEM
  TECNICO
  CONSCIENTIZACAO
  OUTRO
}

enum ModalidadeTreinamento {
  PRESENCIAL
  EAD
  SEMIPRESENCIAL
}

enum ResultadoEficacia {
  EFICAZ
  NAO_EFICAZ
}

enum MotivoGatilhoReciclagem {
  MUDANCA_FUNCAO
  RETORNO_AFASTAMENTO
  ACIDENTE_INCIDENTE
  MUDANCA_PROCEDIMENTO
  OUTRO
}

/// Treinamento do catálogo. Obrigatoriedade: `obrigatorioTodos` OU setores listados (Usuario.setorId) — ver docs/06 (P7).
model Treinamento {
  id                    String          @id @default(uuid()) @db.Uuid
  empresaId             String          @map("empresa_id") @db.Uuid
  nome                  String
  tipo                  TipoTreinamento
  descricao             String?
  cargaHoraria          Int?            @map("carga_horaria")
  /// null = não vence.
  validadeMeses         Int?            @map("validade_meses")
  obrigatorioTodos      Boolean         @default(false) @map("obrigatorio_todos")
  obrigatorioSetorIds   String[]        @default([]) @map("obrigatorio_setor_ids") @db.Uuid
  obrigatorioFuncaoIds  String[]        @default([]) @map("obrigatorio_funcao_ids") @db.Uuid
  /// Conscientização (ISO 9001 7.3): ciência da revisão vigente deste documento conta como realização.
  documentoId           String?         @map("documento_id") @db.Uuid
  /// Crítico: pendência (vencido/não realizado/reciclagem pendente) em obrigatório torna a pessoa inapta.
  critico               Boolean         @default(false)
  /// Dias após a sessão para avaliar a eficácia (null = não exige avaliação).
  diasAvaliacaoEficacia Int?            @map("dias_avaliacao_eficacia")
  ativo                 Boolean         @default(true)
  versao                Int             @default(0)
  criadoPorId           String          @map("criado_por_id") @db.Uuid
  criadoEm              DateTime        @default(now()) @map("criado_em")
  atualizadoEm          DateTime        @updatedAt @map("atualizado_em")

  empresa   Empresa             @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  criadoPor Usuario             @relation("TreinamentoCriadoPor", fields: [empresaId, criadoPorId], references: [empresaId, id], onDelete: Restrict)
  documento Documento?          @relation(fields: [empresaId, documentoId], references: [empresaId, id], onDelete: Restrict)
  sessoes   SessaoTreinamento[]
  gatilhos  GatilhoReciclagem[]

  @@unique([empresaId, id])
  @@unique([empresaId, nome])
  @@map("treinamento")
}

/// Turma/sessão realizada de um treinamento.
model SessaoTreinamento {
  id                    String                @id @default(uuid()) @db.Uuid
  empresaId             String                @map("empresa_id") @db.Uuid
  treinamentoId         String                @map("treinamento_id") @db.Uuid
  dataRealizacao        DateTime              @map("data_realizacao") @db.Date
  instrutor             String
  obraId                String?               @map("obra_id") @db.Uuid
  cargaHoraria          Int?                  @map("carga_horaria")
  observacao            String?
  modalidade            ModalidadeTreinamento @default(PRESENCIAL)
  conteudoProgramatico  String?               @map("conteudo_programatico")
  qualificacaoInstrutor String?               @map("qualificacao_instrutor")
  criadoPorId           String                @map("criado_por_id") @db.Uuid
  criadoEm              DateTime              @default(now()) @map("criado_em")
  atualizadoEm          DateTime              @updatedAt @map("atualizado_em")

  empresa       Empresa                   @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  treinamento   Treinamento               @relation(fields: [empresaId, treinamentoId], references: [empresaId, id], onDelete: Restrict)
  obra          ObraUnidade?              @relation(fields: [empresaId, obraId], references: [empresaId, id], onDelete: Restrict)
  criadoPor     Usuario                   @relation("SessaoTreinamentoCriadoPor", fields: [empresaId, criadoPorId], references: [empresaId, id], onDelete: Restrict)
  participacoes ParticipacaoTreinamento[]

  @@unique([empresaId, id])
  @@index([empresaId, treinamentoId, dataRealizacao])
  @@map("sessao_treinamento")
}

/// Presença de um usuário numa sessão. `dataValidade` = dataRealizacao + validadeMeses (null = não vence ou ausente).
model ParticipacaoTreinamento {
  id                  String             @id @default(uuid()) @db.Uuid
  empresaId           String             @map("empresa_id") @db.Uuid
  sessaoId            String             @map("sessao_id") @db.Uuid
  usuarioId           String             @map("usuario_id") @db.Uuid
  presente            Boolean            @default(true)
  aproveitamento      String?
  certificadoAnexoId  String?            @map("certificado_anexo_id") @db.Uuid
  dataValidade        DateTime?          @map("data_validade") @db.Date
  registradoPorId     String             @map("registrado_por_id") @db.Uuid
  eficaciaResultado   ResultadoEficacia? @map("eficacia_resultado")
  eficaciaObservacao  String?            @map("eficacia_observacao")
  eficaciaAvaliadaEm  DateTime?          @map("eficacia_avaliada_em")
  eficaciaAvaliadorId String?            @map("eficacia_avaliador_id") @db.Uuid
  criadoEm            DateTime           @default(now()) @map("criado_em")
  atualizadoEm        DateTime           @updatedAt @map("atualizado_em")

  empresa           Empresa           @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  avaliadorEficacia Usuario?          @relation("ParticipacaoAvaliadorEficacia", fields: [empresaId, eficaciaAvaliadorId], references: [empresaId, id], onDelete: Restrict)
  sessao            SessaoTreinamento @relation(fields: [empresaId, sessaoId], references: [empresaId, id], onDelete: Restrict)
  usuario           Usuario           @relation("ParticipacaoUsuario", fields: [empresaId, usuarioId], references: [empresaId, id], onDelete: Restrict)
  registradoPor     Usuario           @relation("ParticipacaoRegistradoPor", fields: [empresaId, registradoPorId], references: [empresaId, id], onDelete: Restrict)
  certificado       Anexo?            @relation(fields: [empresaId, certificadoAnexoId], references: [empresaId, id], onDelete: Restrict)

  @@unique([empresaId, id])
  @@unique([empresaId, sessaoId, usuarioId])
  @@index([empresaId, usuarioId])
  @@map("participacao_treinamento")
}

/// Evento que exige reciclagem (afastamento, mudança de função etc.). Pendente enquanto não houver realização presente
/// do treinamento com data posterior ao evento — status calculado, sem flag "resolvido".
model GatilhoReciclagem {
  id              String                  @id @default(uuid()) @db.Uuid
  empresaId       String                  @map("empresa_id") @db.Uuid
  usuarioId       String                  @map("usuario_id") @db.Uuid
  treinamentoId   String                  @map("treinamento_id") @db.Uuid
  motivo          MotivoGatilhoReciclagem
  dataEvento      DateTime                @map("data_evento") @db.Date
  descricao       String?
  registradoPorId String                  @map("registrado_por_id") @db.Uuid
  criadoEm        DateTime                @default(now()) @map("criado_em")

  empresa       Empresa     @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  usuario       Usuario     @relation("GatilhoUsuario", fields: [empresaId, usuarioId], references: [empresaId, id], onDelete: Restrict)
  treinamento   Treinamento @relation(fields: [empresaId, treinamentoId], references: [empresaId, id], onDelete: Restrict)
  registradoPor Usuario     @relation("GatilhoRegistradoPor", fields: [empresaId, registradoPorId], references: [empresaId, id], onDelete: Restrict)

  @@unique([empresaId, id])
  @@index([empresaId, usuarioId, treinamentoId])
  @@map("gatilho_reciclagem")
}
