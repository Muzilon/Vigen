/// Mensagens dentro do sistema, por entidade (thread = entidadeTipo + entidadeId).
model Interacao {
  id             String                @id @default(uuid()) @db.Uuid
  empresaId      String                @map("empresa_id") @db.Uuid
  entidadeTipo   TipoEntidadeInteracao @map("entidade_tipo")
  entidadeId     String                @map("entidade_id") @db.Uuid
  autorId        String                @map("autor_id") @db.Uuid
  destinatarioId String?               @map("destinatario_id") @db.Uuid
  mensagem       String
  criadoEm       DateTime              @default(now()) @map("criado_em")

  empresa      Empresa            @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  autor        Usuario            @relation("InteracaoAutor", fields: [empresaId, autorId], references: [empresaId, id], onDelete: Restrict)
  destinatario Usuario?           @relation("InteracaoDestinatario", fields: [empresaId, destinatarioId], references: [empresaId, id], onDelete: Restrict)
  leituras     LeituraInteracao[]

  @@unique([empresaId, id])
  @@index([empresaId, entidadeTipo, entidadeId, criadoEm])
  @@index([empresaId, destinatarioId, criadoEm])
  @@map("interacao")
}

/// Leitura de uma interação por um usuário.
model LeituraInteracao {
  empresaId   String   @map("empresa_id") @db.Uuid
  interacaoId String   @map("interacao_id") @db.Uuid
  usuarioId   String   @map("usuario_id") @db.Uuid
  lidaEm      DateTime @default(now()) @map("lida_em")

  empresa   Empresa   @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  interacao Interacao @relation(fields: [empresaId, interacaoId], references: [empresaId, id], onDelete: Cascade)
  usuario   Usuario   @relation(fields: [empresaId, usuarioId], references: [empresaId, id], onDelete: Cascade)

  @@id([empresaId, interacaoId, usuarioId])
  @@index([empresaId, usuarioId])
  @@map("leitura_interacao")
}

/// Notificação in-app (e opcionalmente por e-mail) para um usuário.
/// chaveIdempotencia: evita duplicar o mesmo evento (ex.: cron executado 2x).
model Notificacao {
  id                String                   @id @default(uuid()) @db.Uuid
  empresaId         String                   @map("empresa_id") @db.Uuid
  usuarioId         String                   @map("usuario_id") @db.Uuid
  tipo              TipoNotificacao
  entidadeTipo      TipoEntidadeNotificacao? @map("entidade_tipo")
  entidadeId        String?                  @map("entidade_id") @db.Uuid
  titulo            String
  corpo             String
  link              String?
  lidaEm            DateTime?                @map("lida_em")
  emailEnviadoEm    DateTime?                @map("email_enviado_em")
  /// M4: PENDENTE -> ENVIADO | IGNORADO (e-mail desativado/sem endereço) | FALHOU (reenvio até o limite).
  emailStatus       StatusEmailNotificacao   @default(PENDENTE) @map("email_status")
  emailTentativas   Int                      @default(0) @map("email_tentativas")
  /// Momento do último claim (evita envio em paralelo por duas execuções).
  emailTentativaEm  DateTime?                @map("email_tentativa_em")
  chaveIdempotencia String                   @map("chave_idempotencia")
  criadoEm          DateTime                 @default(now()) @map("criado_em")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  usuario Usuario @relation(fields: [empresaId, usuarioId], references: [empresaId, id], onDelete: Cascade)

  @@unique([empresaId, id])
  @@unique([empresaId, chaveIdempotencia])
  @@index([empresaId, usuarioId, lidaEm])
  @@index([empresaId, usuarioId, criadoEm])
  @@index([empresaId, emailStatus, criadoEm])
  @@map("notificacao")
}

/// Escala (P×S ou similar) de um tipo (Riscos/Oportunidades, HIRA, Aspecto/Impacto) para uma
/// empresa, com sobrescrita opcional por obra/unidade. Resolução em código (não em SQL):
/// obra (se houver override) → empresa (obraId nulo) → padrão do sistema (src/lib/escala/padrao.ts).
/// obraId nulo = configuração padrão da empresa; a unicidade "só um registro padrão por
/// empresa+tipo" é garantida por índice único parcial (ver migração:
/// configuracao_escala_empresa_tipo_padrao_key, WHERE obra_id IS NULL).
model ConfiguracaoEscala {
  id              String     @id @default(uuid()) @db.Uuid
  empresaId       String     @map("empresa_id") @db.Uuid
  tipo            TipoEscala
  obraId          String?    @map("obra_id") @db.Uuid
  /// 3 (3x3) ou 5 (5x5).
  tamanho         Int
  /// Rótulos e pesos por eixo. Ex.: [{ "chave": "probabilidade", "rotulo": "Probabilidade",
  /// "niveis": [{ "valor": 1, "rotulo": "Raro" }, ...] }, { "chave": "severidade", ... }]
  eixos           Json
  /// Faixas de nível a partir do score (produto dos eixos). Ex.: [{ "limite": 4, "nivel":
  /// "BAIXO", "cor": "baixa" }, { "limite": 9, "nivel": "MEDIO", "cor": "media" }, ...]
  faixas          Json
  /// Critérios adicionais opcionais (ex.: significância do aspecto/impacto no LAIA).
  criteriosExtras Json?      @map("criterios_extras")
  criadoEm        DateTime   @default(now()) @map("criado_em")
  atualizadoEm    DateTime   @updatedAt @map("atualizado_em")

  empresa Empresa      @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  obra    ObraUnidade? @relation(fields: [empresaId, obraId], references: [empresaId, id], onDelete: Cascade)

  @@unique([empresaId, id])
  @@unique([empresaId, tipo, obraId])
  @@index([empresaId, tipo])
  @@map("configuracao_escala")
}

/// Fluxo de aprovação multi-assinante (estilo DocuSign) sobre uma entidade de qualquer módulo.
/// payload: a alteração proposta, aplicada pelo handler do entidadeTipo (aoAprovar) na mesma
/// transação da última aprovação. versao: trava otimista (toda decisão incrementa).
/// Um único fluxo PENDENTE por (empresa, entidadeTipo, entidadeId): índice único parcial na migração.
model FluxoAprovacao {
  id            String                 @id @default(uuid()) @db.Uuid
  empresaId     String                 @map("empresa_id") @db.Uuid
  entidadeTipo  TipoEntidadeAprovacao  @map("entidade_tipo")
  entidadeId    String                 @map("entidade_id") @db.Uuid
  tipoAlteracao TipoAlteracaoAprovacao @map("tipo_alteracao")
  modo          ModoAprovacao
  status        StatusFluxoAprovacao   @default(PENDENTE)
  solicitanteId String                 @map("solicitante_id") @db.Uuid
  payload       Json                   @default("{}")
  resumo        String
  versao        Int                    @default(0)
  criadoEm      DateTime               @default(now()) @map("criado_em")
  concluidoEm   DateTime?              @map("concluido_em")

  empresa          Empresa              @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  solicitante      Usuario              @relation("FluxoSolicitante", fields: [empresaId, solicitanteId], references: [empresaId, id], onDelete: Restrict)
  etapas           EtapaAprovacao[]
  historico        HistoricoAprovacao[]
  versoesDocumento VersaoDocumento[]

  @@unique([empresaId, id])
  @@index([empresaId, entidadeTipo, entidadeId])
  @@index([empresaId, solicitanteId, status])
  @@index([empresaId, status])
  @@map("fluxo_aprovacao")
}

model EtapaAprovacao {
  id          String               @id @default(uuid()) @db.Uuid
  empresaId   String               @map("empresa_id") @db.Uuid
  fluxoId     String               @map("fluxo_id") @db.Uuid
  ordem       Int
  aprovadorId String               @map("aprovador_id") @db.Uuid
  status      StatusEtapaAprovacao
  decididoEm  DateTime?            @map("decidido_em")
  comentario  String?

  empresa   Empresa        @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  fluxo     FluxoAprovacao @relation(fields: [empresaId, fluxoId], references: [empresaId, id], onDelete: Restrict)
  aprovador Usuario        @relation("EtapaAprovador", fields: [empresaId, aprovadorId], references: [empresaId, id], onDelete: Restrict)

  @@unique([empresaId, id])
  @@unique([empresaId, fluxoId, ordem])
  @@unique([empresaId, fluxoId, aprovadorId])
  @@index([empresaId, aprovadorId, status])
  @@map("etapa_aprovacao")
}

/// Append-only (trigger na migração bloqueia UPDATE/DELETE).
model HistoricoAprovacao {
  id         String                 @id @default(uuid()) @db.Uuid
  empresaId  String                 @map("empresa_id") @db.Uuid
  fluxoId    String                 @map("fluxo_id") @db.Uuid
  etapaId    String?                @map("etapa_id") @db.Uuid
  usuarioId  String                 @map("usuario_id") @db.Uuid
  acao       AcaoHistoricoAprovacao
  comentario String?
  metadados  Json?
  criadoEm   DateTime               @default(now()) @map("criado_em")

  empresa Empresa        @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  fluxo   FluxoAprovacao @relation(fields: [empresaId, fluxoId], references: [empresaId, id], onDelete: Restrict)
  usuario Usuario        @relation("HistoricoAprovacaoUsuario", fields: [empresaId, usuarioId], references: [empresaId, id], onDelete: Restrict)

  @@unique([empresaId, id])
  @@index([empresaId, fluxoId, criadoEm])
  @@map("historico_aprovacao")
}

/// Tentativas de login (rate limit por e-mail e IP). Global: e-mail é único no sistema.
/// Mapa de Processos (ISO 9001 4.4). Código único por empresa; exclusão = inativar (ativo=false).
/// `versao` = última versão publicada (0 = nunca publicado); `revisao` = trava otimista de edição.
model Processo {
  id           String       @id @default(uuid()) @db.Uuid
  empresaId    String       @map("empresa_id") @db.Uuid
  codigo       String
  nome         String
  tipo         TipoProcesso
  ordem        Int          @default(0)
  objetivo     String?
  donoId       String?      @map("dono_id") @db.Uuid
  entradas     String?
  saidas       String?
  fornecedores String?
  clientes     String?
  recursos     String?
  versao       Int          @default(0)
  revisao      Int          @default(0)
  ativo        Boolean      @default(true)
  criadoEm     DateTime     @default(now()) @map("criado_em")
  atualizadoEm DateTime     @updatedAt @map("atualizado_em")

  empresa           Empresa             @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  dono              Usuario?            @relation("ProcessoDono", fields: [empresaId, donoId], references: [empresaId, id], onDelete: Restrict)
  indicadores       IndicadorProcesso[]
  interacoesOrigem  InteracaoProcesso[] @relation("InteracaoOrigem")
  interacoesDestino InteracaoProcesso[] @relation("InteracaoDestino")
  versoes           VersaoProcesso[]
  riscos            RiscoOportunidade[]
  linhasHira        LinhaHira[]
  linhasLaia        LinhaLaia[]
  documentos        Documento[]
  inspecoes         Inspecao[]
  auditorias        Auditoria[]
  indicadoresModulo Indicador[]

  @@unique([empresaId, id])
  @@unique([empresaId, codigo])
  @@index([empresaId, tipo, ordem])
  @@map("processo")
}

model IndicadorProcesso {
  id            String   @id @default(uuid()) @db.Uuid
  empresaId     String   @map("empresa_id") @db.Uuid
  processoId    String   @map("processo_id") @db.Uuid
  nome          String
  meta          String?
  unidade       String?
  periodicidade String?
  ordem         Int      @default(0)
  criadoEm      DateTime @default(now()) @map("criado_em")

  empresa  Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  processo Processo @relation(fields: [empresaId, processoId], references: [empresaId, id], onDelete: Cascade)

  @@unique([empresaId, id])
  @@index([empresaId, processoId])
  @@map("indicador_processo")
}

/// Seta origem → destino no mapa (única por par; origem ≠ destino via CHECK no SQL).
model InteracaoProcesso {
  id        String   @id @default(uuid()) @db.Uuid
  empresaId String   @map("empresa_id") @db.Uuid
  origemId  String   @map("origem_id") @db.Uuid
  destinoId String   @map("destino_id") @db.Uuid
  descricao String?
  criadoEm  DateTime @default(now()) @map("criado_em")

  empresa Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  origem  Processo @relation("InteracaoOrigem", fields: [empresaId, origemId], references: [empresaId, id], onDelete: Cascade)
  destino Processo @relation("InteracaoDestino", fields: [empresaId, destinoId], references: [empresaId, id], onDelete: Cascade)

  @@unique([empresaId, id])
  @@unique([empresaId, origemId, destinoId])
  @@index([empresaId, destinoId])
  @@map("interacao_processo")
}

/// Snapshot publicado (append-only: trigger bloqueia UPDATE/DELETE).
model VersaoProcesso {
  id             String   @id @default(uuid()) @db.Uuid
  empresaId      String   @map("empresa_id") @db.Uuid
  processoId     String   @map("processo_id") @db.Uuid
  versao         Int
  snapshot       Json
  observacao     String?
  publicadoPorId String   @map("publicado_por_id") @db.Uuid
  publicadoEm    DateTime @default(now()) @map("publicado_em")

  empresa      Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  processo     Processo @relation(fields: [empresaId, processoId], references: [empresaId, id], onDelete: Restrict)
  publicadoPor Usuario  @relation("VersaoProcessoPublicadoPor", fields: [empresaId, publicadoPorId], references: [empresaId, id], onDelete: Restrict)

  @@unique([empresaId, id])
  @@unique([empresaId, processoId, versao])
  @@map("versao_processo")
}

/// Riscos e oportunidades (ISO 9001 6.1). Nível = P×I pela ConfiguracaoEscala RISCO_OPORTUNIDADE
/// resolvida por obra → empresa → padrão; gravado (score/faixa) para filtro e heatmap.
model RiscoOportunidade {
  id                    String                  @id @default(uuid()) @db.Uuid
  empresaId             String                  @map("empresa_id") @db.Uuid
  numero                Int
  tipo                  TipoRiscoOportunidade
  processoId            String?                 @map("processo_id") @db.Uuid
  obraId                String?                 @map("obra_id") @db.Uuid
  descricao             String
  causa                 String?
  consequencia          String?
  probabilidade         Int
  impacto               Int
  score                 Int
  faixa                 FaixaNivel
  tratamento            TratamentoRisco?
  descricaoTratamento   String?                 @map("descricao_tratamento")
  probabilidadeResidual Int?                    @map("probabilidade_residual")
  impactoResidual       Int?                    @map("impacto_residual")
  scoreResidual         Int?                    @map("score_residual")
  faixaResidual         FaixaNivel?             @map("faixa_residual")
  status                StatusRiscoOportunidade @default(IDENTIFICADO)
  responsavelId         String?                 @map("responsavel_id") @db.Uuid
  planoAcaoId           String?                 @map("plano_acao_id") @db.Uuid
  modoReavaliacao       ModoReavaliacao         @default(ITEM) @map("modo_reavaliacao")
  periodicidadeMeses    Int                     @default(12) @map("periodicidade_meses")
  proximaReavaliacaoEm  DateTime?               @map("proxima_reavaliacao_em") @db.Date
  ultimaReavaliacaoEm   DateTime?               @map("ultima_reavaliacao_em")
  versao                Int                     @default(0)
  ativo                 Boolean                 @default(true)
  criadoPorId           String                  @map("criado_por_id") @db.Uuid
  criadoEm              DateTime                @default(now()) @map("criado_em")
  atualizadoEm          DateTime                @updatedAt @map("atualizado_em")

  empresa     Empresa                      @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  processo    Processo?                    @relation(fields: [empresaId, processoId], references: [empresaId, id], onDelete: Restrict)
  obra        ObraUnidade?                 @relation(fields: [empresaId, obraId], references: [empresaId, id], onDelete: Restrict)
  responsavel Usuario?                     @relation("RiscoResponsavel", fields: [empresaId, responsavelId], references: [empresaId, id], onDelete: Restrict)
  criadoPor   Usuario                      @relation("RiscoCriadoPor", fields: [empresaId, criadoPorId], references: [empresaId, id], onDelete: Restrict)
  planoAcao   PlanoAcao?                   @relation(fields: [empresaId, planoAcaoId], references: [empresaId, id], onDelete: Restrict)
  historico   HistoricoRiscoOportunidade[]
